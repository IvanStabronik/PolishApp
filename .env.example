# Local / shared env example — SŁOWARIUM
# Copy to `.env` (root) and/or `web/.env.local`. Do not commit real secrets.
# Dev DB credentials match docker-compose.yml (host port 5433 → container 5432).

DATABASE_URL=postgresql://slowarium:slowarium@localhost:5433/slowarium
BETTER_AUTH_SECRET=dev-only-change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
CONTENT_PREVIEW_SECRET=dev-only-content-preview-secret
DEMO_MODE=true
NEXT_PUBLIC_DEMO_PREVIEW=true
PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
