{
  "name": "slowarium-workspace",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "pnpm --dir web dev",
    "build": "pnpm --dir web build",
    "lint": "pnpm --dir web lint",
    "typecheck": "pnpm --dir web typecheck",
    "test": "pnpm --dir web test",
    "test:e2e": "pnpm --dir web test:e2e",
    "content:validate": "pnpm --dir web content:validate",
    "content:import": "pnpm --dir web content:import",
    "db:migrate": "pnpm --dir web db:migrate",
    "db:seed": "pnpm --dir web db:seed"
  }
}
