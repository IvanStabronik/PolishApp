{
  "name": "slowarium",
  "version": "0.1.0",
  "private": true,
  "description": "SŁOWARIUM — Akademia języka polskiego (modular monolith)",
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test && playwright test -c playwright.no-demo.config.ts",
    "test:e2e:smoke": "playwright test",
    "test:e2e:no-demo": "playwright test -c playwright.no-demo.config.ts",
    "content:validate": "tsx scripts/content-validate.ts",
    "content:import": "tsx --env-file=.env.local scripts/content-import.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env.local src/db/migrate.ts",
    "db:seed": "tsx --env-file=.env.local src/db/seed/index.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.3.7",
    "better-auth": "^1.3.7",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.44.5",
    "next": "15.5.4",
    "next-intl": "^4.3.5",
    "postgres": "^3.4.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "uuid": "^11.1.0",
    "yaml": "^2.8.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^5.0.2",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.5",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
