# Copy to `.env.local` — never commit real secrets.
# Dev credentials match docker-compose.yml (postgres service).
# Production: see `.env.production.example` and `pnpm ops:generate-secret`.

DATABASE_URL=postgresql://slowarium:slowarium@localhost:5433/slowarium
BETTER_AUTH_SECRET=dev-only-change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000
INVITE_TOKEN_PEPPER=dev-only-invite-pepper-change-me
PRIVACY_AUDIT_SECRET=dev-only-privacy-audit-secret
CONTENT_PREVIEW_SECRET=dev-preview-secret
# Closed-beta DRAFT learning for invitees (also honored in production with BETA_MODE).
# Aliases: CLOSED_BETA_PREVIEW, ALLOW_DRAFT_PREVIEW
BETA_ALLOW_DRAFT=true
# Closed beta: require invite for registration (Better Auth open sign-up disabled).
BETA_MODE=true
# Demo seed + system roles (server-side). NEVER enable via NEXT_PUBLIC alone.
DEMO_MODE=true
DEMO_PREVIEW=true
NEXT_PUBLIC_DEMO_PREVIEW=true
# Production must set DEMO_MODE=false DEMO_PREVIEW=false and BETA_ALLOW_DRAFT=true
# (see .env.production.example). Do not set ALLOW_PRODUCTION_DEMO for real private beta.
PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
