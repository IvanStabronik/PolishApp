# Production private-beta example — copy values into the host secret store.
# NEVER commit a filled `.env.production` or real credentials.

NODE_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/slowarium
BETTER_AUTH_SECRET=GENERATE_WITH_pnpm_ops_generate_secret
INVITE_TOKEN_PEPPER=GENERATE_WITH_pnpm_ops_generate_secret
PRIVACY_AUDIT_SECRET=GENERATE_WITH_pnpm_ops_generate_secret

# Public HTTPS URL (provider URL or custom domain)
BETTER_AUTH_URL=https://YOUR_PRIVATE_BETA_HOST
NEXT_PUBLIC_APP_URL=https://YOUR_PRIVATE_BETA_HOST
APP_URL=https://YOUR_PRIVATE_BETA_HOST
# Optional extra origins (comma-separated)
# TRUSTED_ORIGINS=https://YOUR_CUSTOM_DOMAIN

BETA_MODE=true
DEMO_MODE=false
DEMO_PREVIEW=false
# Closed-beta: invitees with previewer may learn on DRAFT without DEMO theater
BETA_ALLOW_DRAFT=true
# ALLOW_PRODUCTION_DEMO must stay unset/false for real private beta

PORT=3000
HOSTNAME=0.0.0.0
